rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{docId} { allow read, write: if true; }
    match /fcm_tokens/{docId} { allow read, write: if true; }
    match /settings/{docId} { allow read, write: if true; }
    match /shifts2/{docId} { allow read, write: if true; }
    match /assigned_shifts/{docId} { allow read, write: if true; }
    match /schedules2/{docId} { allow read, write: if true; }
    match /schedule_memos/{docId} { allow read, write: if true; }
    match /scheduleChanges/{docId} { allow read, write: if true; }
    match /school_times/{docId} { allow read, write: if true; }
    match /events/{docId} { allow read, write: if true; }
    match /event_participants/{docId} { allow read, write: if true; }
    match /event_past_photos/{docId} { allow read, write: if true; }
    match /year_event_details/{docId} { allow read, write: if true; }
    match /vacation_flyers/{docId} { allow read, write: if true; }
    match /albums2/{docId} { allow read, write: if true; }
    match /album_events2/{docId} { allow read, write: if true; }
    match /lessons/{docId} { allow read, write: if true; }
    match /pickup_assignments/{docId} { allow read, write: if true; }
    match /paid_transport_members/{docId} { allow read, write: if true; }
    match /paid_transport_monthly/{docId} { allow read, write: if true; }
    match /paid_transport_records/{docId} { allow read, write: if true; }
    match /conversations/{docId} {
      allow read, write: if true;
      match /messages/{msgId} { allow read, write: if true; }
    }
    match /admin_notices/{docId} { allow read, write: if true; }
    match /surveys/{docId} { allow read, write: if true; }
    match /survey_responses/{docId} { allow read, write: if true; }
    match /typing_students/{docId} { allow read, write: if true; }
    match /typing_certifiers/{docId} { allow read, write: if true; }
    match /typing_certs/{docId} { allow read, write: if true; }
    match /entry_logs/{docId} { allow read, write: if true; }

    match /push_subscriptions_v2/{docId} { allow read, write: if true; }
    match /push_subscriptions_v2/{docId}/devices/{deviceId} { allow read, write: if true; }

    // スタッフ本人の勤務通知設定を保存するコレクション。
    match /staff_shift_notification_settings/{docId} { allow read, write: if true; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
